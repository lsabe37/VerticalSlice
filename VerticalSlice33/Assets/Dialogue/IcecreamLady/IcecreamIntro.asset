  m_Name: IcecreamIntro
  m_EditorClassIdentifier: 
  dialogue:
  - Hey there honey~ Today is so cold and gloomy. But being near you makes me feel
    warm.
  - You wouldn't happen to still have that elongated donut would you?
  - The one that looks like a sea cucumber.
  responses:
  - responseText: Why do you want the long donut?
    dialogueObject: {fileID: 11400000, guid: 4b0334b5846da6046b7b1066ca7a2927, type: 2}
  - responseText: Is your head melting?
    dialogueObject: {fileID: 11400000, guid: 11cde2f1a4636904faa371e8b3702c80, type: 2}
