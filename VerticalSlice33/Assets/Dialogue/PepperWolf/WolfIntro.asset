  m_Script: {fileID: 11500000, guid: 2fe0abe2bc63b4548846bb100704dbfe, type: 3}
  m_Name: WolfIntro
  m_EditorClassIdentifier: 
  dialogue:
  - My, what do we have here. Some fine pastries.
  - I'll take that bright red thing. Yes, just one will do. It has no idea what I
    have in store for it...
  - Heh eheheh ehehe ahehehee.
  responses:
  - responseText: I didn't know wolves ate donuts too.
    dialogueObject: {fileID: 11400000, guid: 77a01ee0fb7f33b4aa158a0d8f9f62ff, type: 2}
  - responseText: Are you suffering from male pattern balding?
    dialogueObject: {fileID: 11400000, guid: dd73a0f7cdc609242a81a89f89c01e60, type: 2}
